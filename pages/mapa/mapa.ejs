<section class="spa-section" id="spa-mapa" style="display:none;">
  <div class="map-shell">

    <!-- ── SIDEBAR ─────────────────────────────────────────────────────── -->
    <div class="map-sidebar" id="mapSidebar">

      <!-- Header del sidebar -->
      <div class="msb-header">
        <div class="msb-logo">CyL Turismo</div>
        <button class="msb-collapse-btn" id="sidebarToggle" onclick="toggleSidebar()" title="Colapsar panel">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
      </div>

      <!-- Pestañas: Explorar / Itinerario -->
      <div class="msb-tabs msb-tabs-main">
        <button class="msb-tab active" id="tabExplorar" onclick="switchMapTab('explorar')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          Explorar
        </button>
        <button class="msb-tab" id="tabPlanificador" onclick="switchMapTab('planificador')">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Itinerario
        </button>
      </div>

      <!-- ── PANEL ITINERARIO (planificador del cuestionario) ──────────── -->
      <div id="mapPanelPlanificador" class="msb-panel" style="display:none;">

        <!-- Plan generado tras completar el cuestionario -->
        <div id="mapTabsWrap" style="display:none;">
          <div class="locked-feature" id="plannerContent">
            <div id="lockedOverlay" class="locked-overlay">
              <p><svg class="cat-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg> Regístrate para ver el itinerario completo con horarios</p>
              <button class="btn" onclick="openModal('register')">Registrarse gratis</button>
            </div>
            <div id="dayPlanContainer" class="msb-dayplan"></div>
            <div id="plannerBtnWrap" style="padding:12px 16px 4px;display:none;flex-wrap:wrap;gap:8px;">
              <button class="btn" id="plannerSaveBtn" onclick="savePlannerItinerary()" style="flex:1;min-width:120px;font-size:0.82rem;">
                💾 Guardar
              </button>
              <button class="pdf-btn" id="pdfBtn" onclick="downloadItinerarioPDF()" style="display:none;flex:1;min-width:120px;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:15px;height:15px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                PDF
              </button>
            </div>
          </div>
        </div>

        <!-- Empty state cuando aún no hay plan generado -->
        <div id="mapEmptyState" class="msb-empty">
          <div class="msb-empty-icon"><svg class="cat-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></div>
          <p>Aún no has creado un itinerario.</p>
          <button onclick="openOnboarding()" class="btn" style="margin-top:16px;font-size:0.82rem;padding:8px 20px;">
            Crear mi itinerario
          </button>
        </div>

      </div>

      <!-- ── PANEL EXPLORAR (provincia + categoría + lista) ────────────── -->
      <div id="mapPanelExplorar" class="msb-panel">

        <!-- Selector de provincia -->
        <div class="msb-section">
          <div class="msb-section-label">Provincia</div>
          <div class="msb-province-grid" id="province-list-explore"></div>
          <div id="d3-map-container" style="margin-top:12px;"></div>
        </div>

        <!-- Filtros de categoría -->
        <div class="msb-section" id="catFilterSection" style="display:none;">
          <div class="msb-section-label">Categoría</div>
          <div id="catFilterBar" class="msb-cat-filters"></div>
        </div>

        <!-- Lista de sitios -->
        <div id="markersGrid" class="msb-markers-list" style="padding:0 10px 12px;"></div>
        <div id="markersShowMore" style="display:none;text-align:center;padding:12px 0;"></div>

      </div>

    </div>

    <!-- ── MAPA LEAFLET ──────────────────────────────────────────────── -->
    <div class="map-main">
      <div class="map-province-chip" id="provinceChip" style="display:none;">
        <span id="provinceTitle">—</span>
        <span id="markerCount" class="map-province-count"></span>
      </div>
      <button class="map-sidebar-fab" id="sidebarFab" onclick="toggleSidebar()" style="display:none;" title="Abrir panel">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
      <div id="map" style="width:100%;height:100%;"></div>

      <!-- FAB: Crear itinerario (lanza el cuestionario) -->
      <button class="map-itinerary-fab" onclick="openOnboarding();" id="itineraryFab">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;flex-shrink:0;"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <span>Crear mi itinerario</span>
      </button>
    </div>

  </div>
</section>
