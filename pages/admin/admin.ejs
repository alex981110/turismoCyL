<div class="admin-panel" id="adminPanel">
  <div class="admin-header">
    <h1><span class="admin-stamp">CyL</span> Panel de administración</h1>
    <div class="d-flex gap-3 align-items-center">
      <span class="admin-role">Administrador</span>
      <button class="btn btn-outline" onclick="hideAdmin()">Cerrar</button>
    </div>
  </div>
  <div class="admin-body">
    <div class="row g-4" id="adminGridRow">
      <div class="col-12 col-lg-6">
        <div class="admin-card h-100">
          <h3>Importar marcadores desde CSV</h3>
          <p class="admin-note">Columnas: nombre, latitud, longitud, provincia, categoría, descripción.</p>
          <button type="button" class="admin-drop" onclick="document.getElementById('csvInput').click()">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M12 18v-6M9 15l3-3 3 3"/></svg>
            <strong>Arrastra tu CSV aquí</strong>
            <span>o haz clic para seleccionarlo</span>
          </button>
          <input type="file" id="csvInput" accept=".csv" style="display:none;" onchange="handleCSVUpload(event)">
          <div id="csvStatus" style="margin-top:12px;font-size:0.95rem;"></div>
          <div class="admin-example">
            <div class="form-label-cyl">Ejemplo</div>
            <pre>nombre,lat,lng,provincia,cat,desc,foto
Catedral de Burgos,42.3411,-3.7006,Burgos,monumento,"Catedral gótica...","https://..."
Las Médulas,42.4588,-6.7743,León,naturaleza,"Patrimonio UNESCO...","https://..."</pre>
          </div>
        </div>
      </div>
      <div class="col-12 col-lg-6">
        <div class="admin-card h-100">
          <h3>Marcadores <span class="admin-count"><span id="markerTotalCount">0</span> en total, <span id="markerShownCount">0</span> a la vista</span></h3>
          <div class="input-group input-group-cyl mb-3">
            <input id="adminMarkerSearch" type="text" class="form-control form-control-cyl" placeholder="Buscar por nombre, provincia o categoría..." aria-label="Buscar marcadores" oninput="adminMarkersLimit=20;renderAdminMarkers()" />
            <button class="pw-toggle" onclick="document.getElementById('adminMarkerSearch').value='';renderAdminMarkers()" title="Limpiar búsqueda" aria-label="Limpiar búsqueda"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
          </div>
          <div class="admin-table-wrap">
            <table class="admin-table" id="adminMarkersTable">
              <thead><tr><th>Nombre</th><th>Provincia</th><th>Categoría</th><th>Foto</th><th><span class="visually-hidden">Acciones</span></th></tr></thead>
              <tbody id="adminMarkersBody">
                <tr><td colspan="5" class="admin-empty">Sin marcadores todavía</td></tr>
              </tbody>
            </table>
          </div>
          <div id="adminMarkersMore" style="display:none;text-align:center;padding:16px 0 4px;">
            <button class="msb-more-btn" onclick="adminMarkersLimit+=100;renderAdminMarkers()">
              Ver 100 más <span id="adminMarkersRemaining" class="msb-more-count"></span>
            </button>
          </div>
        </div>
      </div>
      <div class="col-12 col-lg-6">
        <div class="admin-card h-100">
          <h3>Usuarios <span class="admin-count" id="userTotalCount">0</span></h3>
          <div class="admin-table-wrap">
            <table class="admin-table" id="usersTable">
              <thead><tr><th>Nombre</th><th>Email</th><th>Rol</th><th>Fecha</th></tr></thead>
              <tbody id="usersBody"></tbody>
            </table>
          </div>
        </div>
      </div>
      <div class="col-12 col-lg-6">
        <div class="admin-card h-100">
          <h3>Lugares por provincia</h3>
          <div id="statsContainer"></div>
        </div>
      </div>

      <div class="col-12">
        <div class="admin-card">
          <h3>Valoraciones <span class="admin-count"><span id="ratingsTotalCount">0</span> reseñas</span></h3>
          <div id="adminRatingsContainer">
            <p class="admin-note">Sin valoraciones todavía.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
