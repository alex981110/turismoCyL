<section class="hero-immersive spa-section spa-hero" id="spa-home">

  <!-- Carrusel de fondo -->
  <div class="hero-bg" id="heroBg">
    <div class="hero-slide active" style="background-image:url('/hero/segovia.jpg')"></div>
    <div class="hero-slide" style="background-image:url('/hero/burgos.jpg')"></div>
    <div class="hero-slide" style="background-image:url('/hero/salamanca.jpg')"></div>
    <div class="hero-slide" style="background-image:url('/hero/leon.jpg')"></div>
    <div class="hero-slide" style="background-image:url('/hero/avila.jpg')"></div>
    <div class="hero-slide" style="background-image:url('/hero/soria.jpg')"></div>
    <div class="hero-slide" style="background-image:url('/hero/palencia.jpg')"></div>
    <div class="hero-slide" style="background-image:url('/hero/valladolid.jpg')"></div>
    <div class="hero-slide" style="background-image:url('/hero/zamora.jpg')"></div>
    <div class="hero-bg-overlay"></div>
  </div>

  <!-- Pie de foto del carrusel -->
  <p class="hero-caption" aria-live="polite">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
    <span id="heroSlideLabel">Acueducto Romano · Segovia</span>
  </p>

  <!-- Contenido centrado -->
  <div class="hero-immersive-content">

    <h1 class="hero-immersive-title">
      Descubre el corazón<br>
      <em>de España</em>
    </h1>

    <p class="hero-immersive-sub">
      Monumentos, naturaleza, gastronomía y cultura.<br>
      Tu itinerario personalizado te espera.
    </p>

    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
      <button onclick="launchTravelAnimation()" class="hero-immersive-btn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="width:18px;height:18px;"><path d="M3 12h18M3 6l9-3 9 3M3 18l9 3 9-3"/></svg>
        Explorar el mapa
      </button>
    </div>

    <div class="hero-immersive-steps">
      <span><strong>2.619</strong> lugares</span>
      <span class="hero-step-dot">·</span>
      <span><strong>9</strong> provincias</span>
      <span class="hero-step-dot">·</span>
      <span><strong>63</strong> días de itinerario</span>
    </div>

    <!-- Puntos indicadores -->
    <div class="hero-carousel-dots" id="heroCarouselDots"></div>

  </div>



</section>

<script>
(function() {
  var SLIDES = [
    { label: 'Acueducto Romano · Segovia' },
    { label: 'Catedral · Burgos' },
    { label: 'Plaza Mayor · Salamanca' },
    { label: 'Las Médulas · León' },
    { label: 'Murallas medievales · Ávila' },
    { label: 'Laguna Negra · Soria' },
    { label: 'San Martín de Frómista · Palencia' },
    { label: 'Iglesia de San Pablo · Valladolid' },
    { label: 'Catedral · Zamora' }
  ];

  var slides   = document.querySelectorAll('.hero-slide');
  var dotsWrap = document.getElementById('heroCarouselDots');
  var labelEl  = document.getElementById('heroSlideLabel');
  if (labelEl) labelEl.style.transition = 'opacity 0.4s ease';
  var current = 0;

  slides.forEach(function(_, i) {
    var dot = document.createElement('button');
    dot.className = 'hero-dot' + (i === 0 ? ' active' : '');
    dot.setAttribute('aria-label', SLIDES[i].label);
    dot.onclick = function() { goTo(i); resetTimer(); };
    dotsWrap.appendChild(dot);
  });

  function goTo(idx) {
    slides[current].classList.remove('active');
    dotsWrap.children[current].classList.remove('active');
    current = idx;
    slides[current].classList.add('active');
    dotsWrap.children[current].classList.add('active');
    if (labelEl) {
      labelEl.style.opacity = '0';
      setTimeout(function() {
        labelEl.textContent = SLIDES[current].label;
        labelEl.style.opacity = '1';
      }, 300);
    }
  }

  function next() { goTo((current + 1) % slides.length); }
  var timer = setInterval(next, 6000);
  function resetTimer() { clearInterval(timer); timer = setInterval(next, 6000); }

  var bg = document.getElementById('heroBg');
  if (bg) {
    bg.addEventListener('mouseenter', function() { clearInterval(timer); });
    bg.addEventListener('mouseleave', function() { timer = setInterval(next, 6000); });
  }
})();

/* ── Transición "ruta trazada" hacia el mapa ── */
(function() {
  var DRAW_MS = 2000;   // trazado de la ruta
  var HOLD_MS = 350;    // pausa con la ruta completa
  var FADE_MS = 450;    // fundido hacia el mapa (igual que en home.css)
  var SEEN_KEY = 'cylRouteIntroSeen';

  var overlay = document.getElementById('routeIntro');
  var path    = document.getElementById('routeIntroPath');
  var head    = document.getElementById('routeIntroHead');
  var skipBtn = document.getElementById('routeIntroSkip');
  var cities  = overlay ? Array.prototype.slice.call(overlay.querySelectorAll('.ri-city')) : [];
  var running = false, raf = 0, holdTimer = 0, total = 0, cityAt = [];

  function easeInOutCubic(t) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; }

  // Distancia a lo largo de la ruta a la que queda cada capital
  function measure() {
    total = path.getTotalLength();
    var samples = [];
    for (var i = 0; i <= 600; i++) {
      var l = total * i / 600, pt = path.getPointAtLength(l);
      samples.push([l, pt.x, pt.y]);
    }
    cityAt = cities.map(function(c) {
      var x = +c.dataset.x, y = +c.dataset.y, best = 0, bestD = Infinity;
      samples.forEach(function(s) {
        var d = (s[1] - x) * (s[1] - x) + (s[2] - y) * (s[2] - y);
        if (d < bestD) { bestD = d; best = s[0]; }
      });
      return best;
    });
  }

  function seen() { try { return sessionStorage.getItem(SEEN_KEY) === '1'; } catch (e) { return false; } }
  function markSeen() { try { sessionStorage.setItem(SEEN_KEY, '1'); } catch (e) {} }

  function finish() {
    if (!running) return;
    running = false;
    cancelAnimationFrame(raf);
    clearTimeout(holdTimer);
    document.removeEventListener('keydown', onKey);
    navigateTo('/mapa');
    overlay.classList.add('is-leaving');
    setTimeout(function() {
      overlay.hidden = true;
      overlay.classList.remove('is-visible', 'is-leaving');
      document.body.style.overflow = '';
    }, FADE_MS);
  }

  function onKey(e) { if (e.key === 'Escape' || e.key === 'Enter' || e.key === ' ') { e.preventDefault(); finish(); } }

  window.launchTravelAnimation = function() {
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Solo la primera vez por sesión; con movimiento reducido, directo al mapa
    if (!overlay || reduce || seen()) { navigateTo('/mapa'); return; }
    if (running) return;
    running = true;
    markSeen();

    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    if (!total) measure();
    path.style.strokeDasharray = total + ' ' + total;
    path.style.strokeDashoffset = total;
    cities.forEach(function(c) { c.classList.remove('is-reached'); });
    void overlay.offsetWidth;            // fuerza el estado inicial antes del fundido
    overlay.classList.add('is-visible');
    document.addEventListener('keydown', onKey);
    skipBtn.focus({ preventScroll: true });

    var start = performance.now() + 250;  // deja entrar el fondo antes de trazar
    function frame(now) {
      var t = Math.min(1, Math.max(0, (now - start) / DRAW_MS));
      var len = total * easeInOutCubic(t);
      path.style.strokeDashoffset = total - len;
      var pt = path.getPointAtLength(len);
      head.setAttribute('cx', pt.x);
      head.setAttribute('cy', pt.y);
      cities.forEach(function(c, i) { if (len >= cityAt[i] - 1) c.classList.add('is-reached'); });
      if (t < 1) raf = requestAnimationFrame(frame);
      else holdTimer = setTimeout(finish, HOLD_MS);
    }
    raf = requestAnimationFrame(frame);
  };

  if (overlay) {
    overlay.addEventListener('click', finish);
  }
})();
</script>
