<div class="spa-section" id="spa-home">
<section class="hero-immersive" aria-labelledby="heroTitle">

  <!-- Carrusel de fondo: las fotos se cargan desde JS (la visible y la siguiente) -->
  <div class="hero-bg" id="heroBg">
    <div class="hero-slide active" data-img="segovia"></div>
    <div class="hero-slide" data-img="burgos"></div>
    <div class="hero-slide" data-img="salamanca"></div>
    <div class="hero-slide" data-img="leon"></div>
    <div class="hero-slide" data-img="avila"></div>
    <div class="hero-slide" data-img="soria"></div>
    <div class="hero-slide" data-img="palencia"></div>
    <div class="hero-slide" data-img="valladolid"></div>
    <div class="hero-slide" data-img="zamora"></div>
    <div class="hero-bg-overlay"></div>
  </div>

  <div class="hero-grid">
    <!-- Mensaje y acciones -->
    <div class="hero-copy">
      <p class="hero-code" aria-hidden="true"><span id="heroCode">SG</span></p>
      <h1 class="hero-immersive-title" id="heroTitle">Tu escapada por Castilla y León</h1>
      <p class="hero-immersive-sub">2.619 lugares en nueve provincias. Dinos qué te gusta y te montamos el plan con horario, por zonas y con su ruta.</p>
      <div class="hero-actions">
        <button type="button" onclick="launchTravelAnimation()" class="hero-immersive-btn">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"/><path d="M9 4v14M15 6v14"/></svg>
          Explorar el mapa
        </button>
        <button type="button" onclick="openOnboarding()" class="hero-ghost-btn">Crear mi plan</button>
      </div>
    </div>

    <!-- Panel de salidas: el día 1 real de la provincia que se ve en la foto -->
    <aside class="dep-board" aria-labelledby="depTitle">
      <header class="dep-head">
        <h2 class="dep-title" id="depTitle">Día 1 en <span id="depProv">Segovia</span></h2>
        <span class="dep-code" id="depCode">SG</span>
      </header>
      <div class="dep-cols" aria-hidden="true"><span>Hora</span><span>Lugar</span><span>Parada</span></div>
      <ol class="dep-rows" id="depRows" aria-live="polite"></ol>
      <footer class="dep-foot">
        <button type="button" class="dep-link" id="depOpen">
          Ver la provincia en el mapa
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </footer>
    </aside>
  </div>

  <!-- Pie: foto actual y selector de provincia por código -->
  <div class="hero-bottom">
    <p class="hero-caption" aria-live="polite">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
      <span id="heroSlideLabel">Acueducto romano, Segovia</span>
    </p>
    <div class="hero-carousel-dots" id="heroCarouselDots" role="group" aria-label="Elegir provincia de la portada"></div>
  </div>

</section>

<%- include('provinces') %>
</div>

<script>
(function() {
  var SLIDES = [
    { prov: 'Segovia',    label: 'Acueducto romano, Segovia' },
    { prov: 'Burgos',     label: 'Catedral, Burgos' },
    { prov: 'Salamanca',  label: 'Plaza Mayor, Salamanca' },
    { prov: 'León',       label: 'Las Médulas, León' },
    { prov: 'Ávila',      label: 'Murallas medievales, Ávila' },
    { prov: 'Soria',      label: 'Laguna Negra, Soria' },
    { prov: 'Palencia',   label: 'San Martín de Frómista, Palencia' },
    { prov: 'Valladolid', label: 'Iglesia de San Pablo, Valladolid' },
    { prov: 'Zamora',     label: 'Catedral, Zamora' }
  ];
  var CODES = { 'Ávila': 'AV', 'Burgos': 'BU', 'León': 'LE', 'Palencia': 'P', 'Salamanca': 'SA', 'Segovia': 'SG', 'Soria': 'SO', 'Valladolid': 'VA', 'Zamora': 'ZA' };

  var slides   = document.querySelectorAll('.hero-slide');
  var dotsWrap = document.getElementById('heroCarouselDots');
  var labelEl  = document.getElementById('heroSlideLabel');
  var codeEl   = document.getElementById('heroCode');
  var rowsEl   = document.getElementById('depRows');
  var reduce   = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var current = 0;

  // WebP a 1920 px en pantallas grandes y a 1080 px en el resto (densidad máx. 2)
  function heroSrc(name) {
    var w = (window.innerWidth || 1440) * Math.min(window.devicePixelRatio || 1, 2);
    return '/hero/' + name + '-' + (w > 1400 ? 1920 : 1080) + '.webp';
  }
  function loadSlide(i) {
    var el = slides[i];
    if (!el || el.dataset.loaded) return;
    el.style.backgroundImage = "url('" + heroSrc(el.dataset.img) + "')";
    el.dataset.loaded = '1';
  }
  loadSlide(0);
  window.addEventListener('load', function() { loadSlide(1); });

  // Selector por código de provincia (hace de puntos del carrusel)
  slides.forEach(function(_, i) {
    var b = document.createElement('button');
    b.type = 'button';
    b.className = 'hero-dot' + (i === 0 ? ' active' : '');
    b.textContent = CODES[SLIDES[i].prov];
    b.setAttribute('aria-label', SLIDES[i].prov);
    b.setAttribute('aria-pressed', i === 0 ? 'true' : 'false');
    b.onclick = function() { goTo(i); resetTimer(); };
    dotsWrap.appendChild(b);
  });

  // Panel de salidas: día 1 real de la provincia (dayPlans, en data.js)
  function esc(s) { return String(s).replace(/[&<>"]/g, function(c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function renderBoard(prov, animate) {
    if (typeof dayPlans === 'undefined' || !rowsEl) return;
    var items = ((dayPlans[prov] || {}).dia1 || []).slice(0, 5);
    document.getElementById('depProv').textContent = prov;
    document.getElementById('depCode').textContent = CODES[prov];
    rowsEl.innerHTML = items.map(function(it, i) {
      var t = it.time.length === 4 ? '0' + it.time : it.time;
      return '<li class="dep-row' + (i === 0 ? ' is-next' : '') + '" style="--i:' + i + '">' +
        '<span class="dep-time">' + esc(t) + '</span>' +
        '<span class="dep-place">' + esc(it.place) + '</span>' +
        '<span class="dep-stop">' + (i + 1) + '/' + items.length + '</span></li>';
    }).join('');
    if (animate && !reduce) {
      rowsEl.classList.remove('is-flipping');
      void rowsEl.offsetWidth;
      rowsEl.classList.add('is-flipping');
    }
  }
  document.addEventListener('DOMContentLoaded', function() { renderBoard(SLIDES[0].prov, false); });
  document.getElementById('depOpen').addEventListener('click', function() {
    if (typeof goToProvince === 'function') goToProvince(SLIDES[current].prov);
    else navigateTo('/mapa');
  });

  function goTo(idx) {
    if (idx === current) return;
    slides[current].classList.remove('active');
    dotsWrap.children[current].classList.remove('active');
    dotsWrap.children[current].setAttribute('aria-pressed', 'false');
    current = idx;
    loadSlide(current);
    loadSlide((current + 1) % slides.length);
    slides[current].classList.add('active');
    dotsWrap.children[current].classList.add('active');
    dotsWrap.children[current].setAttribute('aria-pressed', 'true');
    var s = SLIDES[current];
    if (labelEl) labelEl.textContent = s.label;
    if (codeEl) {
      codeEl.textContent = CODES[s.prov];
      if (!reduce) { codeEl.classList.remove('is-in'); void codeEl.offsetWidth; codeEl.classList.add('is-in'); }
    }
    renderBoard(s.prov, true);
  }

  function next() { goTo((current + 1) % slides.length); }
  var timer = setInterval(next, 7000);
  function resetTimer() { clearInterval(timer); timer = setInterval(next, 7000); }

  // Pausa mientras el puntero está sobre la portada o el foco dentro de ella
  var hero = document.querySelector('.hero-immersive');
  if (hero) {
    hero.addEventListener('mouseenter', function() { clearInterval(timer); });
    hero.addEventListener('mouseleave', resetTimer);
    hero.addEventListener('focusin', function() { clearInterval(timer); });
    hero.addEventListener('focusout', resetTimer);
  }
  document.addEventListener('visibilitychange', function() { if (document.hidden) clearInterval(timer); else resetTimer(); });
})();

/* ── Barra translúcida solo mientras se ve la foto de portada ── */
(function() {
  var nav = document.getElementById('mainNavbar');
  var hero = document.querySelector('#spa-home .hero-immersive');
  if (!nav || !hero || !('IntersectionObserver' in window)) return;
  var io = new IntersectionObserver(function(entries) {
    nav.classList.toggle('navbar-on-hero', entries[0].isIntersecting);
  }, { rootMargin: '-' + (nav.offsetHeight || 64) + 'px 0px 0px 0px', threshold: 0 });
  io.observe(hero);
})();

/* ── Transición "viaje por las nueve provincias" hacia el mapa ──
   Se dibujan las provincias, una caravana recorre las capitales parándose en
   cada una (con su tarjeta) y el contorno aterriza sobre el mapa de Leaflet.
   Solo la primera vez por sesión; se puede saltar con clic, Esc, Intro o Espacio. */
(function() {
  var INTRO_MS = 900, FIRST_MS = 650, LEG_MS = 560, DWELL_MS = 260, LAND_MS = 850;
  var FADE_MS  = 450;   // igual que .is-leaving en home.css
  var SEEN_KEY = 'cylRouteIntroSeen';

  // Paradas en el orden de la ruta
  var STOPS = {
    'León':       { img: 'leon',       place: 'Las Médulas',            code: 'LE' },
    'Palencia':   { img: 'palencia',   place: 'San Martín de Frómista', code: 'P'  },
    'Burgos':     { img: 'burgos',     place: 'Catedral',               code: 'BU' },
    'Soria':      { img: 'soria',      place: 'Laguna Negra',           code: 'SO' },
    'Segovia':    { img: 'segovia',    place: 'Acueducto romano',       code: 'SG' },
    'Ávila':      { img: 'avila',      place: 'Murallas medievales',    code: 'AV' },
    'Salamanca':  { img: 'salamanca',  place: 'Plaza Mayor',            code: 'SA' },
    'Zamora':     { img: 'zamora',     place: 'Catedral',               code: 'ZA' },
    'Valladolid': { img: 'valladolid', place: 'Iglesia de San Pablo',   code: 'VA' }
  };

  var overlay = document.getElementById('routeIntro');
  if (!overlay) { window.launchTravelAnimation = function() { navigateTo('/mapa'); }; return; }

  var svg    = overlay.querySelector('.route-intro-svg');
  var path   = document.getElementById('routeIntroPath');
  var head   = document.getElementById('routeIntroHead');
  var card   = document.getElementById('routeIntroCard');
  var img    = card.querySelector('.ri-card-img');
  var count  = card.querySelector('.ri-card-count');
  var name   = card.querySelector('.ri-card-name');
  var place  = card.querySelector('.ri-card-place');
  var code   = card.querySelector('.ri-card-code');
  var cities = Array.prototype.slice.call(overlay.querySelectorAll('.ri-city'));
  var provs  = Array.prototype.slice.call(overlay.querySelectorAll('.ri-provinces path'));

  var running = false, raf = 0, timers = [], total = 0, cityAt = [], heading = 0;

  function later(fn, ms) { timers.push(setTimeout(fn, ms)); }
  function seen() { try { return sessionStorage.getItem(SEEN_KEY) === '1'; } catch (e) { return false; } }
  function markSeen() { try { sessionStorage.setItem(SEEN_KEY, '1'); } catch (e) {} }
  function easeInOutCubic(t) { return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; }

  // Distancia a lo largo de la ruta a la que queda cada capital
  function measure() {
    total = path.getTotalLength();
    var samples = [];
    for (var i = 0; i <= 600; i++) {
      var l = total * i / 600, pt = path.getPointAtLength(l);
      samples.push([l, pt.x, pt.y]);
    }
    cityAt = cities.map(function(c) {
      var x = +c.dataset.x, y = +c.dataset.y, best = 0, bestD = Infinity;
      samples.forEach(function(s) {
        var d = (s[1] - x) * (s[1] - x) + (s[2] - y) * (s[2] - y);
        if (d < bestD) { bestD = d; best = s[0]; }
      });
      return best;
    });
  }

  // Coloca la caravana en la ruta y la orienta según la tangente: se inclina
  // como mucho 40° y, si va hacia la izquierda, se refleja en vez de girar
  // para no quedar boca abajo
  function placeHead(len, snap) {
    var pt = path.getPointAtLength(len);
    var a = path.getPointAtLength(Math.max(0, len - 2));
    var b = path.getPointAtLength(Math.min(total, len + 2));
    var target = Math.atan2(b.y - a.y, b.x - a.x) * 180 / Math.PI;
    var diff = ((target - heading + 540) % 360) - 180;
    heading = snap ? target : heading + diff * 0.25;
    var left = Math.cos(heading * Math.PI / 180) < 0;
    var tilt = left ? heading - 180 : heading;
    tilt = ((tilt + 540) % 360) - 180;
    tilt = Math.max(-40, Math.min(40, tilt));
    head.setAttribute('transform', 'translate(' + pt.x.toFixed(1) + ' ' + pt.y.toFixed(1) + ') rotate(' + tilt.toFixed(1) + ')' + (left ? ' scale(-1 1)' : ''));
  }

  // Transformación que lleva el contorno del SVG sobre Castilla y León en el mapa
  // de Leaflet. Ambos usan Mercator, así que basta escalar y desplazar a partir de
  // dos capitales: León (primera ciudad) y Soria (cuarta).
  function fitToLeaflet() {
    if (typeof map === 'undefined' || !map || !svg.getScreenCTM) return null;
    var ctm = svg.getScreenCTM(), box = svg.getBoundingClientRect();
    function screen(el) {
      var pt = svg.createSVGPoint(); pt.x = +el.dataset.x; pt.y = +el.dataset.y;
      return pt.matrixTransform(ctm);
    }
    var sa = screen(cities[0]), sb = screen(cities[3]);
    var mc = map.getContainer().getBoundingClientRect();
    var ma = map.latLngToContainerPoint([42.5987, -5.5671]);
    var mb = map.latLngToContainerPoint([41.7666, -2.4637]);
    var s = Math.hypot(mb.x - ma.x, mb.y - ma.y) / Math.hypot(sb.x - sa.x, sb.y - sa.y);
    if (!isFinite(s) || s <= 0) return null;
    return { ox: sa.x - box.left, oy: sa.y - box.top, dx: mc.left + ma.x - sa.x, dy: mc.top + ma.y - sa.y, s: s };
  }

  function reset() {
    provs.forEach(function(p) { p.style.cssText = ''; p.classList.remove('is-current', 'is-visited'); });
    svg.style.transform = svg.style.transformOrigin = '';
    card.classList.remove('is-in');
  }

  function finish() {
    if (!running) return;
    running = false;
    cancelAnimationFrame(raf);
    timers.forEach(clearTimeout); timers = [];
    document.removeEventListener('keydown', onKey);
    if (location.pathname !== '/mapa') navigateTo('/mapa');
    overlay.classList.add('is-leaving');
    setTimeout(function() {
      overlay.hidden = true;
      overlay.classList.remove('is-visible', 'is-leaving', 'is-drawn', 'is-landing');
      document.body.style.overflow = '';
      reset();
    }, FADE_MS);
  }
  function onKey(e) { if (e.key === 'Escape' || e.key === 'Enter' || e.key === ' ') { e.preventDefault(); finish(); } }

  function arrive(i) {
    var c = cities[i], n = c.dataset.name, stop = STOPS[n] || {};
    c.classList.add('is-reached');
    provs.forEach(function(p) {
      if (p.classList.contains('is-current')) { p.classList.remove('is-current'); p.classList.add('is-visited'); }
      if (p.dataset.name === n) p.classList.add('is-current');
    });
    card.classList.remove('is-in');
    later(function() {
      img.style.backgroundImage = "url('/hero/" + stop.img + "-1080.webp')";
      count.textContent = 'Parada ' + (i + 1) + '/' + cities.length;
      name.textContent = n;
      place.textContent = stop.place || '';
      if (code) code.textContent = stop.code || '';
      card.classList.add('is-in');
    }, i === 0 ? 0 : 180);
  }

  // Tramo i: de la capital i a la i+1
  function leg(i) {
    if (i >= cities.length - 1) { later(land, DWELL_MS + 500); return; }
    var from = cityAt[i], to = cityAt[i + 1], start = performance.now();
    function frame(now) {
      var t = Math.min(1, (now - start) / LEG_MS);
      var len = from + (to - from) * easeInOutCubic(t);
      path.style.strokeDashoffset = total - len;
      placeHead(len);
      if (t < 1) { raf = requestAnimationFrame(frame); return; }
      arrive(i + 1);
      later(function() { leg(i + 1); }, DWELL_MS + 120);
    }
    raf = requestAnimationFrame(frame);
  }

  // El mapa se abre debajo y el contorno vuela hasta su sitio antes del fundido
  function land() {
    card.classList.remove('is-in');
    navigateTo('/mapa');
    later(function() {
      var fit = fitToLeaflet();
      if (fit) {
        svg.style.transformOrigin = fit.ox + 'px ' + fit.oy + 'px';
        svg.style.transform = 'translate(' + fit.dx + 'px,' + fit.dy + 'px) scale(' + fit.s + ')';
      }
      overlay.classList.add('is-landing');
    }, 150);
    later(finish, LAND_MS);
  }

  window.launchTravelAnimation = function() {
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    // Con movimiento reducido, o si ya se vio en esta sesión, directo al mapa
    if (reduce || seen()) { navigateTo('/mapa'); return; }
    if (running) return;
    running = true;
    markSeen();

    if (!total) measure();
    path.style.strokeDasharray = total + ' ' + total;
    path.style.strokeDashoffset = total;
    cities.forEach(function(c) { c.classList.remove('is-reached'); });
    provs.forEach(function(p, i) {
      var len = p.getTotalLength();
      p.style.strokeDasharray = len + ' ' + len;
      p.style.strokeDashoffset = len;
      p.style.transitionDelay = (i * 60) + 'ms';
    });

    overlay.hidden = false;
    document.body.style.overflow = 'hidden';
    placeHead(0, true);
    void overlay.offsetWidth;            // estado inicial antes de animar
    overlay.classList.add('is-visible');
    document.addEventListener('keydown', onKey);
    document.getElementById('routeIntroSkip').focus({ preventScroll: true });

    later(function() { overlay.classList.add('is-drawn'); }, 20);
    later(function() { arrive(0); }, INTRO_MS);
    later(function() { leg(0); }, INTRO_MS + FIRST_MS);
  };

  overlay.addEventListener('click', finish);
})();
</script>
