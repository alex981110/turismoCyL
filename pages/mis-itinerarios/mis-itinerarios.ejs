<!-- MIS ITINERARIOS GUARDADOS -->
<section class="day-planner-section spa-section" id="spa-mis-itinerarios" style="border-top:1px solid rgba(201,168,76,0.1);display:none;">
  <div class="container-xxl px-4 py-5">
    <div class="premium-badge">📚 Tus Viajes Guardados</div>
    <h2 class="section-title">Mis <em>Itinerarios</em></h2>
    <p class="section-subtitle">Hasta 3 itinerarios guardados — ábrelos cuando quieras</p>

    <div class="locked-feature" id="myItinContent">
      <div id="myItinLockedOverlay" class="locked-overlay">
        <p>🔒 Inicia sesión para ver tus itinerarios guardados</p>
        <button class="btn" onclick="openModal('login')">Iniciar sesión</button>
      </div>

      <!-- Cabecera con contador y CTA -->
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;margin-bottom:24px;">
        <div id="myItinCounter" style="font-size:0.85rem;color:var(--parch2);"></div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <button class="btn btn-outline" onclick="navigateTo('/mapa')" style="font-size:0.82rem;padding:8px 18px;">
            🗺️ Crear desde el mapa
          </button>
          <button class="btn" onclick="navigateTo('/itinerario')" style="font-size:0.82rem;padding:8px 18px;">
            ✦ Crear nuevo itinerario
          </button>
        </div>
      </div>

      <!-- Grid de itinerarios guardados -->
      <div id="myItinList" class="row g-4"></div>

      <!-- Empty state -->
      <div id="myItinEmpty" style="display:none;text-align:center;padding:60px 20px;">
        <div style="font-size:3.5rem;margin-bottom:14px;opacity:0.6;">🗺️</div>
        <h3 style="font-family:'Playfair Display',serif;color:var(--gold);font-size:1.3rem;margin-bottom:10px;">Aún no tienes itinerarios guardados</h3>
        <p style="color:var(--parch2);font-size:0.9rem;max-width:480px;margin:0 auto 24px;">
          Cuando generes un itinerario en el creador o desde el cuestionario del mapa, podrás guardarlo aquí (hasta 3) y consultarlo cuando vuelvas.
        </p>
        <button class="btn" onclick="navigateTo('/itinerario')">✦ Crear mi primer itinerario</button>
      </div>

    </div>
  </div>
</section>
