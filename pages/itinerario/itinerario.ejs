<section class="day-planner-section spa-section" id="spa-itinerario">
  <div class="container-xxl px-4 py-5">
    <h2 class="section-title">Mi itinerario</h2>
    <p class="section-subtitle">Elige provincia, fecha y los lugares que quieres ver. Nosotros los ordenamos por días y por horario.</p>

    <div class="locked-feature" id="itinerarioContent">
      <div id="itinerarioLockedOverlay" class="locked-overlay">
        <p>Inicia sesión para crear tu itinerario</p>
        <button class="btn" onclick="openModal('login')">Iniciar sesión</button>
      </div>

      <!-- PASO 1: Configuración -->
      <div id="itin-step1" class="itin-step">
        <div class="row g-4 mb-4">
          <div class="col-12 col-md-4">
            <label class="form-label-cyl" for="itinProvince">Provincia</label>
            <select id="itinProvince" class="form-control form-control-cyl" onchange="itinLoadMarkers()">
              <option value="">Selecciona provincia</option>
              <option>Ávila</option><option>Burgos</option><option>León</option>
              <option>Palencia</option><option>Salamanca</option><option>Segovia</option>
              <option>Soria</option><option>Valladolid</option><option>Zamora</option>
            </select>
          </div>
          <div class="col-12 col-md-3">
            <label class="form-label-cyl" for="itinDate">Fecha de inicio</label>
            <input type="date" id="itinDate" class="form-control form-control-cyl" onchange="itinLoadMarkers()">
          </div>
          <div class="col-12 col-md-3">
            <label class="form-label-cyl" for="itinDays">Número de días</label>
            <select id="itinDays" class="form-control form-control-cyl" onchange="itinLoadMarkers()">
              <option value="1">1 día</option>
              <option value="2" selected>2 días</option>
              <option value="3">3 días</option>
            </select>
          </div>
        </div>

        <div id="itinLoadingHours" class="itin-loading" style="display:none;">
          <span class="itin-spinner" aria-hidden="true"></span>
          Comprobando qué lugares abren esos días
        </div>

        <div id="itinMarkersWrap" style="display:none;">
          <div class="itin-pick-head">
            <span class="form-label-cyl" style="margin:0;">Lugares que quieres visitar</span>
            <span id="itinSelCount" class="itin-sel-count">0 seleccionados</span>
          </div>
          <div class="input-group mb-4">
            <input id="itinSearch" type="text" class="form-control form-control-cyl" placeholder="Buscar lugar..." aria-label="Buscar lugar" oninput="itinFilterMarkers(this.value)">
            <button class="pw-toggle" onclick="document.getElementById('itinSearch').value='';itinFilterMarkers('')" title="Limpiar búsqueda" aria-label="Limpiar búsqueda"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
          </div>
          <div id="itinDayColumns" class="row g-3"></div>
          <div class="text-center mt-4">
            <button id="itinGenerateBtn" class="btn" onclick="itinGenerate()" disabled>
              Generar itinerario
            </button>
          </div>
        </div>
      </div>

      <!-- PASO 2: Resultado -->
      <div id="itin-step2" style="display:none;">
        <div class="itin-result-head">
          <div>
            <div id="itinResultTitle" class="itin-result-title"></div>
            <div id="itinResultSub" class="itin-result-sub"></div>
          </div>
          <div class="itin-result-actions">
            <button class="btn btn-outline" onclick="itinReset()">Volver a editar</button>
            <button class="btn" onclick="itinSaveCurrent()" title="Guardar este itinerario (máx. 3)">Guardar</button>
            <button class="pdf-btn" onclick="itinDownloadPDF()">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              Descargar PDF
            </button>
            <span id="itinRouteWrap"></span>
          </div>
        </div>
        <div id="itinDayCards" class="row g-4"></div>
        <div id="itinWarnings" style="margin-top:20px;"></div>
      </div>

    </div>
  </div>
</section>
