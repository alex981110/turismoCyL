<section class="day-planner-section spa-section" id="spa-planificador">
  <div class="container-xxl px-4 py-5">
    <h2 class="section-title">Un fin de semana en <span id="plannerProvince">tu provincia</span></h2>
    <p class="section-subtitle">Dos días con horario para la provincia que elijas. Con cuenta, completo y en PDF.</p>
    <div class="locked-feature" id="plannerContent">
      <div id="lockedOverlay" class="locked-overlay">
        <p>Disponible con cuenta gratuita</p>
        <button class="btn" onclick="openModal('register')">Registrarse gratis</button>
      </div>
      <div id="dayPlanContainer" class="row g-4"></div>
      <div class="text-center mt-2" id="plannerBtnWrap">
        <button class="pdf-btn" id="pdfBtn" onclick="downloadItinerarioPDF()" style="display:none;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
          Descargar itinerario PDF
        </button>
      </div>
    </div>
  </div>
</section>
